{
  "PriorsRequest": {
    "$defs": {
      "TaskContext": {
        "properties": {
          "objective": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Objective"
          },
          "constraints": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Constraints",
            "type": "object"
          }
        },
        "title": "TaskContext",
        "type": "object"
      }
    },
    "properties": {
      "query": {
        "title": "Query",
        "type": "string"
      },
      "task_context": {
        "$ref": "#/$defs/TaskContext"
      },
      "max_priors": {
        "default": 5,
        "minimum": 1,
        "title": "Max Priors",
        "type": "integer"
      },
      "allow_external": {
        "default": false,
        "title": "Allow External",
        "type": "boolean"
      }
    },
    "required": [
      "query"
    ],
    "title": "PriorsRequest",
    "type": "object"
  },
  "PriorsResponse": {
    "$defs": {
      "CandidateConfigValue": {
        "properties": {
          "parameters": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            "title": "Parameters",
            "type": "object"
          },
          "reported_performance": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            "title": "Reported Performance",
            "type": "object"
          },
          "context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Context"
          }
        },
        "required": [
          "parameters"
        ],
        "title": "CandidateConfigValue",
        "type": "object"
      },
      "CautionValue": {
        "properties": {
          "statement": {
            "title": "Statement",
            "type": "string"
          },
          "applicability_scope": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Applicability Scope"
          }
        },
        "required": [
          "statement"
        ],
        "title": "CautionValue",
        "type": "object"
      },
      "Coverage": {
        "properties": {
          "internal_hits": {
            "title": "Internal Hits",
            "type": "integer"
          },
          "external_hits": {
            "title": "External Hits",
            "type": "integer"
          },
          "gaps": {
            "items": {
              "type": "string"
            },
            "title": "Gaps",
            "type": "array"
          }
        },
        "required": [
          "internal_hits",
          "external_hits"
        ],
        "title": "Coverage",
        "type": "object"
      },
      "MaterialPropertyValue": {
        "properties": {
          "material": {
            "title": "Material",
            "type": "string"
          },
          "form": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Form"
          },
          "property_name": {
            "title": "Property Name",
            "type": "string"
          },
          "magnitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Magnitude"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Unit"
          },
          "conditions": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            "title": "Conditions",
            "type": "object"
          },
          "method": {
            "default": "unknown",
            "enum": [
              "measured",
              "computed",
              "cited",
              "unknown"
            ],
            "title": "Method",
            "type": "string"
          }
        },
        "required": [
          "material",
          "property_name"
        ],
        "title": "MaterialPropertyValue",
        "type": "object"
      },
      "ParameterRangeValue": {
        "properties": {
          "field_name": {
            "title": "Field Name",
            "type": "string"
          },
          "min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min"
          },
          "max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max"
          },
          "typical": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Typical"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "conditions": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            "title": "Conditions",
            "type": "object"
          }
        },
        "required": [
          "field_name",
          "unit"
        ],
        "title": "ParameterRangeValue",
        "type": "object"
      },
      "Prior": {
        "properties": {
          "prior_id": {
            "title": "Prior Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "parameter_range",
              "material_property",
              "scaling_relationship",
              "candidate_config",
              "caution"
            ],
            "title": "Kind",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Field"
          },
          "related_fields": {
            "items": {
              "type": "string"
            },
            "title": "Related Fields",
            "type": "array"
          },
          "value": {
            "anyOf": [
              {
                "$ref": "#/$defs/ParameterRangeValue"
              },
              {
                "$ref": "#/$defs/MaterialPropertyValue"
              },
              {
                "$ref": "#/$defs/ScalingRelationshipValue"
              },
              {
                "$ref": "#/$defs/CandidateConfigValue"
              },
              {
                "$ref": "#/$defs/CautionValue"
              }
            ],
            "title": "Value"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "title": "Confidence",
            "type": "number"
          },
          "sources": {
            "items": {
              "discriminator": {
                "mapping": {
                  "kg_triple": "#/$defs/SourceKGTriple",
                  "paper": "#/$defs/SourcePaper"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/SourcePaper"
                },
                {
                  "$ref": "#/$defs/SourceKGTriple"
                }
              ]
            },
            "minItems": 1,
            "title": "Sources",
            "type": "array"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Notes"
          },
          "provenance": {
            "default": "internal",
            "enum": [
              "internal",
              "external_unverified"
            ],
            "title": "Provenance",
            "type": "string"
          }
        },
        "required": [
          "prior_id",
          "kind",
          "value",
          "confidence",
          "sources"
        ],
        "title": "Prior",
        "type": "object"
      },
      "ScalingRelationshipValue": {
        "properties": {
          "x": {
            "title": "X",
            "type": "string"
          },
          "y": {
            "title": "Y",
            "type": "string"
          },
          "direction": {
            "enum": [
              "positive",
              "negative",
              "convex",
              "concave",
              "non_monotonic",
              "unknown"
            ],
            "title": "Direction",
            "type": "string"
          },
          "functional_form": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Functional Form"
          },
          "validity_range": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Validity Range"
          }
        },
        "required": [
          "x",
          "y",
          "direction"
        ],
        "title": "ScalingRelationshipValue",
        "type": "object"
      },
      "SourceKGTriple": {
        "properties": {
          "type": {
            "const": "kg_triple",
            "default": "kg_triple",
            "title": "Type",
            "type": "string"
          },
          "triple_id": {
            "title": "Triple Id",
            "type": "string"
          }
        },
        "required": [
          "triple_id"
        ],
        "title": "SourceKGTriple",
        "type": "object"
      },
      "SourcePaper": {
        "properties": {
          "type": {
            "const": "paper",
            "default": "paper",
            "title": "Type",
            "type": "string"
          },
          "doi": {
            "title": "Doi",
            "type": "string"
          },
          "span": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Span"
          }
        },
        "required": [
          "doi"
        ],
        "title": "SourcePaper",
        "type": "object"
      }
    },
    "properties": {
      "status": {
        "const": "ok",
        "default": "ok",
        "title": "Status",
        "type": "string"
      },
      "priors": {
        "items": {
          "$ref": "#/$defs/Prior"
        },
        "title": "Priors",
        "type": "array"
      },
      "coverage": {
        "$ref": "#/$defs/Coverage"
      },
      "trace_id": {
        "title": "Trace Id",
        "type": "string"
      }
    },
    "required": [
      "priors",
      "coverage",
      "trace_id"
    ],
    "title": "PriorsResponse",
    "type": "object"
  },
  "BatchEvidenceRequest": {
    "$defs": {
      "CandidateSpec": {
        "properties": {
          "candidate_id": {
            "title": "Candidate Id",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "design_parameters": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Design Parameters",
            "type": "object"
          }
        },
        "required": [
          "candidate_id",
          "description"
        ],
        "title": "CandidateSpec",
        "type": "object"
      }
    },
    "properties": {
      "candidates": {
        "items": {
          "$ref": "#/$defs/CandidateSpec"
        },
        "minItems": 1,
        "title": "Candidates",
        "type": "array"
      }
    },
    "required": [
      "candidates"
    ],
    "title": "BatchEvidenceRequest",
    "type": "object"
  },
  "BatchEvidenceResponse": {
    "$defs": {
      "CandidateEvidence": {
        "properties": {
          "candidate_id": {
            "title": "Candidate Id",
            "type": "string"
          },
          "supporting": {
            "items": {
              "$ref": "#/$defs/EvidenceStance"
            },
            "title": "Supporting",
            "type": "array"
          },
          "refuting": {
            "items": {
              "$ref": "#/$defs/EvidenceStance"
            },
            "title": "Refuting",
            "type": "array"
          },
          "neutral": {
            "items": {
              "$ref": "#/$defs/EvidenceStance"
            },
            "title": "Neutral",
            "type": "array"
          },
          "coverage": {
            "enum": [
              "ok",
              "insufficient"
            ],
            "title": "Coverage",
            "type": "string"
          }
        },
        "required": [
          "candidate_id",
          "coverage"
        ],
        "title": "CandidateEvidence",
        "type": "object"
      },
      "EvidenceStance": {
        "properties": {
          "doi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doi"
          },
          "span": {
            "title": "Span",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "relevance": {
            "title": "Relevance",
            "type": "number"
          },
          "stance": {
            "enum": [
              "supports",
              "refutes",
              "neutral"
            ],
            "title": "Stance",
            "type": "string"
          }
        },
        "required": [
          "doi",
          "span",
          "text",
          "relevance",
          "stance"
        ],
        "title": "EvidenceStance",
        "type": "object"
      }
    },
    "properties": {
      "status": {
        "const": "ok",
        "default": "ok",
        "title": "Status",
        "type": "string"
      },
      "results": {
        "items": {
          "$ref": "#/$defs/CandidateEvidence"
        },
        "title": "Results",
        "type": "array"
      },
      "trace_id": {
        "title": "Trace Id",
        "type": "string"
      }
    },
    "required": [
      "results",
      "trace_id"
    ],
    "title": "BatchEvidenceResponse",
    "type": "object"
  },
  "ErrorResponse": {
    "$defs": {
      "ErrorDetail": {
        "properties": {
          "category": {
            "enum": [
              "retrieval_timeout",
              "schema_validation_failed",
              "insufficient_coverage",
              "benchmark_unavailable"
            ],
            "title": "Category",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "detail": {
            "additionalProperties": true,
            "title": "Detail",
            "type": "object"
          }
        },
        "required": [
          "category",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      }
    },
    "properties": {
      "status": {
        "const": "error",
        "default": "error",
        "title": "Status",
        "type": "string"
      },
      "error": {
        "$ref": "#/$defs/ErrorDetail"
      },
      "trace_id": {
        "title": "Trace Id",
        "type": "string"
      }
    },
    "required": [
      "error",
      "trace_id"
    ],
    "title": "ErrorResponse",
    "type": "object"
  }
}
