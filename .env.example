# Copy this file to .env and fill in real values. .env is gitignored.

# LLM backend used by sciencerag.priors for evidence summarization / answer
# synthesis (spec §9 OQ#2). Any litellm-recognized model string works.
DEEPSEEK_API_KEY=
SCIENCERAG_LLM_MODEL=deepseek/deepseek-v4-pro

# Embedding backend used to build the retrieval index (spec §3.5). Swappable
# independently of the LLM above — but changing it requires rebuilding the
# index, since the index and embedding model version are bound together.
OPENAI_API_KEY=
SCIENCERAG_EMBEDDING_MODEL=text-embedding-3-small
